# Docker Compose environment for the Council of Minds stack.
# Copy to docker/.env — or export these in your shell — before `docker compose up`.
#
#   cp docker/.env.example docker/.env
#
# The one value you actually need is OPENCODE_API_KEY. Everything else has a
# working default, and the default LLM models are all free.

# ===================================================================== providers

# DOCKER CANNOT USE opencode-cli: the container has no OpenCode binary.
# Use ollama (free, local) or opencode (needs a funded account).
#
#   LLM_PROVIDER=ollama     free, local, no key   -> needs --profile local
#   LLM_PROVIDER=opencode   Zen over HTTP, billed -> needs OPENCODE_API_KEY
LLM_PROVIDER=ollama

# Only for LLM_PROVIDER=opencode. Get a key at https://opencode.ai/auth and
# add billing — an unfunded account is refused, and the free tier is locked to
# the OpenCode client regardless.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Fallback model when a role has no explicit model. Free.
LLM_MODEL_DEFAULT=big-pickle

# Per-character models. Leave blank to use the provider's default for that
# role (see backend/llm/catalogue.py for the verified free list).
# Keeping them distinct spreads free-tier rate limits across endpoints.
#
#   LLM_MODEL_MODERATOR=big-pickle
#   LLM_MODEL_ORACLE=longcat-2.5-preview-free
#   LLM_MODEL_SCHOLAR=nemotron-3.5-lightning-free
#   LLM_MODEL_SAGE=mimo-v2.6-flash-free
#   LLM_MODEL_ANALYST=ling-3.1-flash-free
#   LLM_MODEL_HISTORIAN=step-5-preview-free

# For LLM_PROVIDER=ollama: the tag you pulled locally.
OLLAMA_MODEL=gemma4:e4b

# ===================================================================== forum

FORUM_ENABLED=true
# Exchange rounds per topic. Each round is one model call per character, so
# this is the main free-tier cost lever.
FORUM_MAX_ROUNDS=2

# Shared secret for POST /api/forum/intake. Empty means local-only, which is
# the default and the safe one. Set this before exposing the API to anything.
FORUM_INTAKE_KEY=

# ===================================================================== ports

FRONTEND_PORT=8090
BACKEND_PORT=8734

# ===================================================================== storage

POSTGRES_DB=council
POSTGRES_USER=council
POSTGRES_PASSWORD=council_dev

# ===================================================================== logging

LOG_LEVEL=INFO

# ===================================================================== graph (profile: graph)

NEO4J_USER=neo4j
NEO4J_PASSWORD=council_dev