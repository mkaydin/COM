# Council of Minds backend configuration
# Copy to .env and adjust. Every value here is read by config.py (Settings).

BACKEND_PORT=8734
LOG_LEVEL=INFO
LOG_DIR=/tmp/com-logs

# --- Local model (Ollama only) ------------------------------------------------
# The Council talks to Ollama's OpenAI-compatible endpoint. There is no API key
# and no provider choice — only the model tag.
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Must match a tag listed by `ollama list`, or every agent call fails and the
# Council silently falls back to zero-confidence answers.
#   ollama list          # see what is installed
#   ollama pull gemma4:e4b
LLM_MODEL=openai/gemma4:e4b

# Leave false for most small local models: they cannot guarantee JSON mode, and
# the agents rely on agents/json_utils.extract_json to parse their output.
# Set true only if your served model honours response_format.
SUPPORTS_JSON_MODE=false

# --- PostgreSQL (Docker: pgvector/pgvector:pg16) ----------------------------
POSTGRES_URL=postgresql+asyncpg://council:council_dev@localhost:5432/council

# --- Neo4j (Docker: neo4j:5-community) --------------------------------------
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=council_dev

# --- ChromaDB (Docker: chromadb/chroma) -------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Divination / web intelligence (Docker: searxng) ------------------------
SEARXNG_URL=http://localhost:8888
