# Council of Minds backend configuration
# Copy to .env and adjust. Every value here is read by config.py (Settings).
#
# Only OPENCODE_API_KEY is required. The default models are all free.

BACKEND_PORT=8734
LOG_LEVEL=INFO
LOG_DIR=/tmp/com-logs

# --- Provider -------------------------------------------------------------------
# opencode (OpenCode Zen) is the default. ollama is the optional local
# provider — set LLM_PROVIDER=ollama and pull the model first.
LLM_PROVIDER=opencode
LLM_MODEL_DEFAULT=big-pickle

# --- OpenCode Zen ---------------------------------------------------------------
# Get a key at https://opencode.ai/auth. The shipped defaults are free-tier
# models, so this costs nothing.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- Per-character models -------------------------------------------------------
# Leave blank to use the provider's default for that role. Keeping them
# distinct spreads free-tier rate limits across endpoints.
# See docs/PROVIDERS.md for the verified free list and how to swap.
LLM_MODEL_MODERATOR=
LLM_MODEL_ORACLE=
LLM_MODEL_SCHOLAR=
LLM_MODEL_SAGE=
LLM_MODEL_ANALYST=
LLM_MODEL_HISTORIAN=

# --- Forum -----------------------------------------------------------------------
FORUM_ENABLED=true
# Exchange rounds per topic. Each round is one model call per character, so
# this is the main free-tier cost lever.
FORUM_MAX_ROUNDS=2
# Shared secret for POST /api/forum/intake (sent as X-COM-Key). Empty means
# local-only, which is the default.
FORUM_INTAKE_KEY=

# --- Ollama (optional local provider) --------------------------------------------
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Legacy single-model setting, kept so an older .env keeps working. Honoured
# only when LLM_MODEL_DEFAULT is not set.
# LLM_MODEL=openai/gemma4:e4b

# Leave false unless your served model honours response_format; the agents
# rely on agents/json_utils.extract_json to parse their output.
SUPPORTS_JSON_MODE=false

# --- PostgreSQL (Docker: pgvector/pgvector:pg16) -------------------------------
POSTGRES_URL=postgresql+asyncpg://council:council_dev@localhost:5432/council

# --- Neo4j (optional; Docker profile: graph) ------------------------------------
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=council_dev

# --- ChromaDB (Docker: chromadb/chroma) ----------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Divination / web intelligence (Docker: searxng) --------------------------
SEARXNG_URL=http://localhost:8888