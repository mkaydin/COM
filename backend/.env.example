# Council of Minds backend configuration
# Copy to .env and adjust. Every value here is read by config.py (Settings).
#
# Only OPENCODE_API_KEY is required. The default models are all free.

BACKEND_PORT=8734
LOG_LEVEL=INFO
LOG_DIR=/tmp/com-logs

# --- Provider -------------------------------------------------------------------
# opencode-go (default) — the Go subscription over plain HTTP. Paid-tier models
#   on a subscription, no CLI involved. Requires OPENCODE_API_KEY.
# opencode — Zen over plain HTTP. Free models are refused for standalone
#   clients ("FreeTierError: can only be used from within OpenCode"), so this
#   needs account funds.
# opencode-cli — the `opencode` CLI. The only route to Zen's FREE models.
#   Needs the CLI on PATH; the backend must run on the host, not in Docker.
# ollama — secondary and local. Free and private, no key at all.
LLM_PROVIDER=opencode-go
LLM_MODEL_DEFAULT=deepseek-v4.1-flash

# --- OpenCode -------------------------------------------------------------------
# Get a key at https://opencode.ai/auth. One key serves both endpoints below.
OPENCODE_API_KEY=
# Zen (free tier + paid). Free entries are refused outside the OpenCode client.
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# The Go subscription. Needs the same key *and* a session header; the backend
# generates one per process unless OPENCODE_SESSION pins it.
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
# OPENCODE_SESSION=

# --- Per-character models -------------------------------------------------------
# Leave blank to use the provider's default for that role. Keeping them
# distinct spreads free-tier rate limits across endpoints.
# See docs/PROVIDERS.md for the verified free list and how to swap.
LLM_MODEL_MODERATOR=
LLM_MODEL_ORACLE=
LLM_MODEL_SCHOLAR=
LLM_MODEL_SAGE=
LLM_MODEL_ANALYST=
LLM_MODEL_HISTORIAN=

# --- Per-character providers ----------------------------------------------------
# Optional. Set one to run a single character through a different backend than
# the rest of the cast — e.g. the Oracle local while the Moderator stays on a
# free Zen model. Blank means "whatever LLM_PROVIDER says". The model for that
# character is then resolved against this provider, not the global one.
# The same bindings can be set at runtime from /models.html, which persists to
# Postgres and survives a restart.
# LLM_PROVIDER_ORACLE=ollama
# LLM_PROVIDER_MODERATOR=

# --- Embedding model ------------------------------------------------------------
# One embedding model is shared by retrieval, the OKF bundle and ingestion.
#   backend: local | ollama | opencode-cli | opencode
#
# `ollama` + `qwen3-embedding:0.6b` is the recommended default. It has a 32k
# window, so nothing is truncated, and its Matryoshka head emits exactly 384
# dimensions — which is what the vector stores are — so it needs no migration.
# `ollama pull qwen3-embedding:0.6b` once.
#
# `local` (all-MiniLM-L6-v2) needs nothing running but has a **256-token**
# window. rag.chunker emits 300-500 token chunks, so it was silently discarding
# ~32% of the OKF bundle and ~92% of the wiki. It is kept as the no-extra-
# services fallback, not as a default.
#
# Changing this model invalidates every stored vector: the new model lives in a
# different vector space, so existing chunks must be re-embedded. Each chunk
# records which embedder produced it; /api/rag/stats reports how many are stale.
#   python backend/tools/reembed.py --status
#   python backend/tools/reembed.py
# Test a model with POST /api/llm/embedding/test before relying on it.
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Forum -----------------------------------------------------------------------
FORUM_ENABLED=true
# Exchange rounds per topic. Each round is one model call per character, so
# this is the main free-tier cost lever.
FORUM_MAX_ROUNDS=2
# Shared secret for POST /api/forum/intake (sent as X-COM-Key). Empty means
# local-only, which is the default.
FORUM_INTAKE_KEY=

# --- Ollama (optional local provider) --------------------------------------------
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Legacy single-model setting, kept so an older .env keeps working. Honoured
# only when LLM_MODEL_DEFAULT is not set.
# LLM_MODEL=gemma4:e4b

# Leave false unless your served model honours response_format; the agents
# rely on agents/json_utils.extract_json to parse their output.
SUPPORTS_JSON_MODE=false

# --- PostgreSQL (Docker: pgvector/pgvector:pg16) -------------------------------
POSTGRES_URL=postgresql+asyncpg://council:council_dev@localhost:5432/council

# --- Neo4j (optional; Docker profile: graph) ------------------------------------
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=council_dev

# --- ChromaDB (Docker: chromadb/chroma) ----------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Divination / web intelligence (Docker: searxng) --------------------------
SEARXNG_URL=http://localhost:8888