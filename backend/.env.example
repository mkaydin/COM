# Council of Minds backend configuration
# Copy to .env and fill in your values

BACKEND_PORT=8734
LOG_LEVEL=INFO
LOG_DIR=/tmp/com-logs

# LLM Provider: openai | anthropic | ollama
# GLM Coding Plan (Z.ai) — OpenAI-compatible endpoint
# Available models: glm-4.5, glm-4.5-air, glm-5.2, glm-4.7, glm-5, glm-5-turbo, glm-5.1, glm-5.2
LLM_PROVIDER=openai
LLM_MODEL=openai/glm-5.2
LLM_API_KEY=your-glm-api-key-here
LLM_API_BASE=https://api.z.ai/api/coding/paas/v4

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL (Docker: pgvector/pgvector:pg16)
POSTGRES_URL=postgresql+asyncpg://council:council_dev@localhost:5432/council

# Neo4j (Docker: neo4j:5-community)
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=council_dev

# Redis (Docker: redis:7-alpine)
REDIS_URL=redis://localhost:6379/0

# ChromaDB (Docker: chromadb/chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8000
