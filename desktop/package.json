{
  "name": "com-council-of-minds",
  "version": "1.0.0",
  "description": "Multi-agent AI deliberation system \u2014 Council of Minds",
  "homepage": "https://github.com/mkaydin/COM",
  "author": {
    "name": "mkaydin",
    "url": "https://github.com/mkaydin"
  },
  "main": "main.js",
  "scripts": {
    "start": "NODE_ENV=dev electron .",
    "start:prod": "electron .",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --linux --mac --win"
  },
  "build": {
    "appId": "ai.council.minds",
    "productName": "Council of Minds",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../com_website/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.pytest_cache/**",
          "!**/node_modules/**"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "mkaydin <mkaydin@users.noreply.github.com>",
      "executableArgs": [
        "--ozone-platform=wayland"
      ],
      "icon": "icons/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
